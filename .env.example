# ==============================================================================
# REAL-TIME CHAT & STREAMING ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to backend/.env and fill in your values.
# Variable names MUST match app/core/config.py exactly.
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp
POSTGRES_DB=chatapp
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://chatapp:chatapp@localhost:5433/chatapp

# Redis (Cache, Pub/Sub, Presence, Tokens)
REDIS_URL=redis://localhost:6379/0

# MinIO (File Storage)
MINIO_ENDPOINT=localhost:9000
# ⚠  config.py reads MINIO_ACCESS_KEY / MINIO_SECRET_KEY / MINIO_BUCKET
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-files
MINIO_SECURE=false

# Apache Kafka (Message Broker - KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CHAT_TOPIC=chat-events

# Security & Authentication
# ⚠  config.py reads SECRET_KEY (not JWT_SECRET_KEY — the old name caused silent 422 errors)
SECRET_KEY=supersecretjwtkeythatmustbechangedinproduction1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Client
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
